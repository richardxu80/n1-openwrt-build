# 上游版本锁定 —— 一次写死，之后构建可复现
# 内核源码（unifreq 的 amlogic 主线内核，ophub 镜像）
KSRC_REPO=https://github.com/ophub/linux-6.12.y
KSRC_REF=5f0944700d793eaa7cf208a571c3415a7800d452

# 内核配置来源（本仓库已 vendor 到 kernel/config-6.12，此处仅记录出处）
KCFG_REPO=https://github.com/ophub/kernel
KCFG_REF=c23196e10d7702ee2906de4a05421d8971fb2717
KCFG_PATH=kernel-config/release/stable/config-6.12

# u-boot 二进制来源（N1：u-boot-2015-phicomm-n1.bin → 跳过区，u-boot-n1.bin → bootfs）
UBOOT_REPO=https://github.com/ophub/u-boot
UBOOT_REF=6e70f41585f15c43f45fcae609adec1865e83eb5

# bootfs 脚本文本来源（boot.cmd / s905_autoscript.cmd 已 vendor 到 bootfs/）
BOOTFILES_REPO=https://github.com/ophub/amlogic-s9xxx-armbian
BOOTFILES_REF=9e71b57f73683f9c4d14a30311e4c2ccbff29566

# OpenWrt 官方底座
OPENWRT_VER=24.10.8
OPENWRT_TARGET=armsr/armv8

# N1 板级参数（model_database.conf id=101 / Phicomm-N1）
BOARD=s905d
FDTFILE=meson-gxl-s905d-phicomm-n1.dtb
SKIP_MB=4
BOOT_MB=384
ROOT_MB=1280
